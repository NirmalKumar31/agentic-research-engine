# Web service image: builds the frontend, then serves it and the API from
# one container. Separate from the CLI Dockerfile because the dependency
# sets and entry points genuinely differ; sharing one image would ship Node
# build tooling into a CLI container for no reason.

# --- frontend ---------------------------------------------------------------
FROM node:24-slim AS frontend

WORKDIR /build
# Copy manifests first so a source-only change reuses the install layer.
COPY web/package.json web/package-lock.json* ./
# npm ci, without a fallback. A committed lockfile should either satisfy
# the install or fail loudly; falling back to npm install would resolve a
# different tree than CI tested and hide the lockfile drift that caused it.
RUN npm ci --no-audit --no-fund

COPY web/ ./
RUN npm run build


# --- python wheel -----------------------------------------------------------
FROM python:3.12-slim AS wheel

WORKDIR /build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip install --upgrade pip build && python -m build --wheel


# --- runtime ----------------------------------------------------------------
FROM python:3.12-slim AS runtime

# trafilatura parses HTML through lxml, which needs these at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libxml2 libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

# Never run as root in a service that fetches arbitrary web pages.
RUN useradd --create-home --uid 1000 researcher
WORKDIR /home/researcher

COPY --from=wheel /build/dist/*.whl /tmp/
COPY constraints.txt ./
# Constrained so a deploy is reproducible and a transitive update cannot
# change behaviour between builds.
RUN pip install --no-cache-dir "$(ls /tmp/*.whl)[web]" -c constraints.txt \
    && rm /tmp/*.whl

COPY pricing.toml ./
COPY --from=frontend /build/dist ./web/dist

USER researcher

# The image is built from a wheel with .git excluded and ships no git
# binary, so the running service cannot discover its own commit. Bake it
# in, or /api/health reports "unavailable" on exactly the instance whose
# identity matters most. Render populates RENDER_GIT_COMMIT itself; this
# arg covers a plain `docker build`:
#   docker build -f Dockerfile.web --build-arg GIT_COMMIT=$(git rev-parse HEAD) .
ARG GIT_COMMIT=""
ENV GIT_COMMIT=$GIT_COMMIT

ENV PYTHONUNBUFFERED=1 \
    LOG_FORMAT=json \
    DEMO_MODE=true \
    PERSIST_RUNS=false \
    CHECKPOINT_BACKEND=memory \
    PORT=8000

EXPOSE 8000

# $PORT is assigned by the host; 0.0.0.0 because a container-local bind is
# unreachable from outside. Single worker: the demo's concurrency cap and
# spend ceilings are per-process, and multiple workers would multiply both.
CMD ["sh", "-c", "exec uvicorn agentic_research.web.api:get_asgi_app --factory --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --timeout-keep-alive 75"]
