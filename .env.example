# ---------------------------------------------------------------------------
# Agentic Research Engine — example configuration
#
# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.example .env
#
# Every value here has a working default except the API keys, so the shortest
# path to a run is: set TAVILY_API_KEY, set LLM_MODE=local, and go.
# ---------------------------------------------------------------------------

# --- Credentials -----------------------------------------------------------
# Required for cloud/hybrid modes. Not needed for LLM_MODE=local.
OPENAI_API_KEY=
# Required for web search in all modes. Free tier is enough for development.
# Get one at https://app.tavily.com
TAVILY_API_KEY=
# Only needed if SEARCH_PROVIDER=brave.
BRAVE_API_KEY=

# --- Execution mode --------------------------------------------------------
# cloud  : every role runs on OpenAI
# local  : every role runs on Ollama (no API key, no per-token cost)
# hybrid : mechanical roles run locally, reasoning roles run on OpenAI
#
# Defaults to local so that `cp .env.example .env` plus a Tavily key is a
# working setup. Switch to hybrid once OPENAI_API_KEY is set; it is the better
# quality/cost balance.
LLM_MODE=local

# --- Cloud models ----------------------------------------------------------
# Reasoning-heavy roles (planning, coverage critique, synthesis, verification).
OPENAI_MODEL=gpt-6-sol
# High-volume mechanical roles (evidence extraction). Cheaper per token.
OPENAI_FAST_MODEL=gpt-6-luna

# --- Local models ----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Per-role overrides (optional) -----------------------------------------
# Format: "<provider>:<model>", e.g. openai:gpt-6-sol or ollama:qwen3:4b.
# Only the first colon separates provider from model, so Ollama tags work.
# Anything left blank falls back to the LLM_MODE default for that role.
# PLANNER_MODEL=openai:gpt-6-sol
# RESEARCHER_MODEL=ollama:qwen3:4b
# CRITIC_MODEL=openai:gpt-6-sol
# SYNTHESIZER_MODEL=openai:gpt-6-sol
# VERIFIER_MODEL=openai:gpt-6-luna

# If a local model is unreachable, fall back to the cloud equivalent.
# Left false by default: an unreachable Ollama should not quietly start
# spending money on OpenAI calls the user did not ask for.
ALLOW_CLOUD_FALLBACK=false

# --- Search ----------------------------------------------------------------
# tavily | brave
SEARCH_PROVIDER=tavily
# basic = 1 Tavily credit, advanced = 2. The engine starts at basic and only
# escalates to advanced on follow-up rounds (see SEARCH_ESCALATE_ON_FOLLOWUP).
SEARCH_DEPTH=basic
SEARCH_ESCALATE_ON_FOLLOWUP=true
MAX_SEARCH_RESULTS=8

# --- Cloud spend ceilings (money, not throughput) --------------------------
# Checked BEFORE each call using that call's worst case, so a ceiling is
# never silently exceeded. 0 means unlimited for that dimension.
# These apply to paid providers only; local inference is unmetered.
MAX_CLOUD_CALLS=40
MAX_CLOUD_INPUT_TOKENS=400000
MAX_CLOUD_OUTPUT_TOKENS=60000
MAX_CLOUD_COST_USD=0.50
MAX_SEARCH_CREDITS=50

# Per-role output ceilings, enforced at the provider. Synthesis needs room;
# a query writer emitting thousands of tokens is a malfunction.
MAX_OUTPUT_TOKENS_PLANNER=2000
MAX_OUTPUT_TOKENS_RESEARCHER=1500
MAX_OUTPUT_TOKENS_CRITIC=1500
MAX_OUTPUT_TOKENS_SYNTHESIZER=6000
MAX_OUTPUT_TOKENS_VERIFIER=400

# --- Budgets (hard stops; the graph cannot exceed these) -------------------
MAX_RESEARCH_ROUNDS=3
MAX_SEARCH_QUERIES=24
MAX_SOURCES=40
MAX_SOURCES_PER_ROUND=12
MAX_LLM_CALLS=60
MAX_PARALLEL_SEARCHES=5
MAX_PARALLEL_FETCHES=8

# --- Retrieval -------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
MAX_PAGE_BYTES=2000000
# PDFs are legitimately larger than web pages and get their own ceiling.
MAX_PDF_BYTES=15000000
MAX_PDF_PAGES=60
MAX_EXTRACT_CHARS=12000

# --- Output & persistence --------------------------------------------------
OUTPUT_DIR=outputs
PERSIST_RUNS=true
# LangGraph checkpointing. sqlite survives a crash; memory is for tests.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_PATH=checkpoints/research.sqlite

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
ENABLE_LANGSMITH=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-research-engine
