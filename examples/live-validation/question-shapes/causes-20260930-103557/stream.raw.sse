event: result
data: {"run_id": "20260930-163558-5cea1b", "report": {"title": "Main Causes of Hallucinations in Large Language Models", "summary_claims": [{"text": "When an LLM lacks a clear signal from training data, it generates a statistically likely continuation that is often confident and wrong.", "kind": "factual", "answer_slot": "items", "evidence_ids": ["S2-e3"], "citation_ids": ["S2"]}], "key_findings": [], "sections": [], "contradictions": [], "limitations": ["The evidence does not establish how decoding choices or sampling settings affect the likelihood of hallucinations.", "The evidence does not establish whether the listed causes are exhaustive.", "The retrieved evidence did not answer: How do decoding choices and sampling settings affect the likelihood of hallucinations.", "Only limited evidence was found for: How do noisy, incomplete, outdated, or contradictory training data contribute to hallucinations in large language models.", "Only limited evidence was found for: How does next-token training and the pressure to produce fluent, helpful answers lead models to generate plausible-sounding but unsupported claims.", "Only limited evidence was found for: How do ambiguous prompts, misleading context, and long-context limitations trigger inaccurate or unsupported answers.", "Only limited evidence was found for: How can failures in retrieval, grounding, or tool use cause a model to present unsupported information as fact.", "3 generated claim(s) were excluded because the cited evidence did not support them, or because verification did not reach them within this run's budget.", "The evidence did not establish whether the list is exhaustive."]}, "plan": {"sub_questions": [{"id": "SQ1", "text": "How do noisy, incomplete, outdated, or contradictory training data contribute to hallucinations in large language models?", "is_followup": false}, {"id": "SQ2", "text": "How does next-token training and the pressure to produce fluent, helpful answers lead models to generate plausible-sounding but unsupported claims?", "is_followup": false}, {"id": "SQ3", "text": "How do knowledge gaps, weak generalization, and difficulty recalling precise or long-tail facts cause hallucinations?", "is_followup": false}, {"id": "SQ4", "text": "How do ambiguous prompts, misleading context, and long-context limitations trigger inaccurate or unsupported answers?", "is_followup": false}, {"id": "SQ5", "text": "How can failures in retrieval, grounding, or tool use cause a model to present unsupported information as fact?", "is_followup": false}, {"id": "SQ6", "text": "How do decoding choices and sampling settings affect the likelihood of hallucinations?", "is_followup": false}]}, "evidence": [{"id": "S4-e1", "source_id": "S4", "sub_question_id": "SQ1", "claim": "Different versions of training data that do not match the reported cutoff can mislead users and cause errors.", "quote": "LLMs may contain different versions of a dataset in their training data than what is specified in a \u201ccutoff\u201d date, misleading users and causing potential errors.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.88, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S4-e2", "source_id": "S4", "sub_question_id": "SQ1", "claim": "Newer CommonCrawl dumps can contain old data, while semantic duplicates and lexical near-duplicates complicate deduplication and contribute to inconsistencies in effective cutoffs.", "quote": "Our analysis reveals two reasons for these inconsistencies: (1) temporal misalignments of CommonCrawl data due to non-trivial amounts of old data in new dumps; and (2) complications in LLM deduplication schemes involving semantic duplicates and lexical near-duplicates.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S4-e3", "source_id": "S4", "sub_question_id": "SQ1", "claim": "A model\u2019s effective knowledge cutoff can be older than its advertised cutoff, leaving users exposed to outdated information such as an older tax code.", "quote": "imagine a layperson using an LLM for tax advice, without realizing that the effective cutoff of the tax code is 2022 and thus outdated \u2013 despite the fact that the reported cutoff is advertised as 2023 (Fig. 1).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S3-e1", "source_id": "S3", "sub_question_id": "SQ3", "claim": "LLMs hallucinate more about entities without Wikipedia pages than about entities with Wikipedia pages, consistent with greater difficulty answering about less well-represented knowledge.", "quote": "LLMs consistently hallucinate more on entities without Wikipedia pages compared to those with them", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "Q6", "cross_attributed": false}, {"id": "S3-e2", "source_id": "S3", "sub_question_id": "SQ5", "claim": "Adding retrieval reduces hallucinations only slightly and does not eliminate them.", "quote": "Finally, given the same base models, adding a retrieval component only slightly reduces hallucinations but does not eliminate hallucinations.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e1", "source_id": "S2", "sub_question_id": "SQ1", "claim": "Training-data limitations and stale, conflicting, or ungoverned retrieval context can contribute to hallucinations.", "quote": "Hallucinations arise from training data limitations, knowledge cutoffs, ambiguous prompts, and \u2014 most critically in enterprise settings \u2014 retrieval context that is stale, conflicting, or ungoverned.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S2-e2", "source_id": "S2", "sub_question_id": "SQ1", "claim": "Underrepresented rare or specialized topics lead models to extrapolate from adjacent patterns instead of retrieving authoritative facts.", "quote": "Even within the training window, rare or specialized topics are underrepresented \u2014 the model generalizes and extrapolates from adjacent patterns rather than retrieving authoritative facts.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S2-e3", "source_id": "S2", "sub_question_id": "SQ2", "claim": "Because LLMs predict tokens from learned statistical patterns rather than knowing facts, their generated answers can be likely continuations that are confidently wrong.", "quote": "LLMs predict the next token based on statistical patterns learned during training \u2014 they do not \u201cknow\u201d facts, they approximate them. When the model lacks a clear signal from training data, it generates the most statistically likely continuation \u2014 which is often confident and wrong.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e4", "source_id": "S2", "sub_question_id": "SQ2", "claim": "A model may still answer confidently when it has no signal for a specialized fact beyond its training cutoff.", "quote": "A model asked about a niche regulatory amendment passed six months after its training cutoff has no signal to draw from. It will still answer, and it will sound confident.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e5", "source_id": "S2", "sub_question_id": "SQ3", "claim": "Knowledge gaps after a model\u2019s training cutoff and underrepresentation of rare topics can lead it to fill gaps with plausible fabrications or extrapolations.", "quote": "Root cause 1: Training data gaps and knowledge cutoff. Models are frozen at a point in time; anything after the cutoff is unknown territory the model fills with plausible fabrications. Even within the training window, rare or specialized topics are underrepresented \u2014 the model generalizes and extrapolates from adjacent patterns rather than retrieving authoritative facts.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e6", "source_id": "S2", "sub_question_id": "SQ4", "claim": "Vague prompts give models more latitude to drift from accuracy because they optimize for coherence rather than factual precision.", "quote": "A vague prompt gives the model more latitude to drift from accuracy; it optimizes for coherence, not factual precision.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e1", "source_id": "S5", "sub_question_id": "SQ2", "claim": "The source describes LLM training as predicting successive tokens and says this objective is used for both pre-training and supervised fine-tuning.", "quote": "The next-token prediction (or language modeling) objective is a self-supervised objective that is used heavily by LLMs for both pre-training and (supervised) fine-tuning. It operates by trying to continually classify the token that comes after the current token within a sequence of text", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.45, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S6-e1", "source_id": "S6", "sub_question_id": "SQ3", "claim": "LLMs can produce factually inconsistent responses when a task exceeds the scope of their training data.", "quote": "However, due to their reliance on fixed parameters, LLMs often produce task-irrelevant outputs or generate factually inconsistent responses when faced with tasks beyond the scope of their training data.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.97, "citable": true, "query_id": "Q6", "cross_attributed": false}, {"id": "S6-e2", "source_id": "S6", "sub_question_id": "SQ4", "claim": "The review identifies context noise, context conflict, and the middle curse in long contexts as generation-phase issues in its analysis of hallucination causes.", "quote": "In the generation phase, we address context noise, context conflict, and the middle curse in long contexts, alignment problems, and model capability boundary problems.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.83, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S6-e3", "source_id": "S6", "sub_question_id": "SQ5", "claim": "The review treats issues in RAG subtasks, including retrieval-phase subtasks, as potential causes of hallucinations.", "quote": "Based on the retrieval and generation phases of RAG, we categorize the sub-tasks in each phase and analyze the fundamental issues causing hallucinations in each sub-task.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.87, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e1", "source_id": "S1", "sub_question_id": "SQ2", "claim": "The source describes next-token prediction as learning to predict the most likely following token from the preceding context, but does not connect this objective to hallucinations or unsupported claims.", "quote": "Next-Token Prediction is a fundamental training objective for language models that learns to predict the most likely subsequent token in a sequence given all preceding tokens as context.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.66, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S1-e2", "source_id": "S1", "sub_question_id": "SQ2", "claim": "Teacher forcing creates exposure bias because training uses ground-truth prefixes while generation proceeds from the model\u2019s own prior predictions.", "quote": "Standard training uses teacher forcing: the model is conditioned on the ground-truth prefix rather than on its own earlier predictions, which produces exposure bias\u2014a mismatch between training conditions and free-running generation\u2014reduced afterwards by post-training stages that optimize the model on its own sampled outputs, such as reinforcement learning from human feedback.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.58, "citable": true, "query_id": "Q3", "cross_attributed": false}], "sources": [{"id": "S1", "url": "https://vstorm.co/glossary/next-token-prediction", "title": "Next-token prediction: how a language model actually learns | Vstorm Glossary", "domain": "vstorm.co", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.554, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S2", "url": "https://atlan.com/know/llm-hallucinations", "title": "LLM Hallucinations: Why They Happen and How to Reduce Them [2026]", "domain": "atlan.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.602, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S3", "url": "https://arxiv.org/html/2407.17468v1", "title": "WildHallucinations: Evaluating Long-form Factuality in LLMs with Real-World Entity Queries", "domain": "arxiv.org", "source_type": "academic", "content_origin": "provider_raw", "quality_score": 0.931, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S4", "url": "https://arxiv.org/html/2403.12958v2", "title": "Dated Data: Tracing Knowledge Cutoffs in Large Language Models", "domain": "arxiv.org", "source_type": "academic", "content_origin": "provider_raw", "quality_score": 0.933, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S5", "url": "https://x.com/cwolferesearch/status/1669811217148289026", "title": "Cameron R. Wolfe, Ph.D. on X: \"Next-token prediction is the workhorse behind all modern advancements in large language models (LLMs) due to its use in training these models over unlabeled text. But, how exactly does this next-token prediction (or language modeling) objective work? Let\u2019s take a deep\u2026 / X", "domain": "x.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.599, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S6", "url": "https://www.mdpi.com/2227-7390/13/5/856", "title": "Hallucination Mitigation for Retrieval-Augmented Large Language Models: A Review", "domain": "mdpi.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.59, "page_count": null, "usable": true, "fetch_status": "provider_content"}], "contract": {"question": "What are the main causes of hallucinations in large language models?", "question_type": "list", "entities": ["large language models", "hallucination"], "dimensions": [], "constraints": [], "ambiguities": [], "usable": true, "unusable_reason": "", "required_slots": [{"name": "items", "description": "The members asked for", "core": true, "satisfied_by": []}, {"name": "completeness", "description": "Whether the list is exhaustive", "core": false, "satisfied_by": []}]}, "verification": {"total_claims": 1, "substantive_claims": 1, "total_citations": 1, "resolvable_citations": 1, "total_evidence_refs": 1, "resolvable_evidence_refs": 1, "supported_claims": 1, "partially_supported_claims": 0, "unsupported_claims": 3, "checked_claims": 4, "checkable_claims": 4, "not_checked_claims": 0, "entailment_exhaustive": true, "contradictions_total": 0, "contradictions_auditable": 0, "