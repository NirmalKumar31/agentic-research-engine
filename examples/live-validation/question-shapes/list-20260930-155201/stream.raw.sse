data: {"run_id": "20260930-155202-278614", "report": {"title": "Main Causes of Hallucinations in Large Language Models", "summary_claims": [], "key_findings": [], "sections": [], "contradictions": [], "limitations": ["The evidence does not establish the relative importance or prevalence of these causes.", "The evidence is limited on how specific training-data problems such as bias, duplication, omissions, and limited coverage cause hallucinations.", "The evidence does not establish how ambiguous prompting affects hallucination rates or how decoding choices, uncertainty calibration, and retrieval or tool-use failures contribute to unsupported claims.", "Only limited evidence was found for: How do training-data problems\u2014including inaccuracies, omissions, bias, duplication, and limited coverage\u2014cause or reinforce hallucinations.", "Only limited evidence was found for: How do prompting, ambiguous instructions, and insufficient or conflicting context affect hallucination rates.", "Only limited evidence was found for: How can decoding choices, uncertainty calibration, and failures in retrieval or tool use contribute to unsupported claims.", "4 generated claim(s) were excluded because the cited evidence did not support them, or because verification did not reach them within this run's budget.", "This research did not answer the question. No claim survived verification, and the material below is background rather than an answer.", "The evidence did not establish what separates it from adjacent things."]}, "plan": {"sub_questions": [{"id": "SQ1", "text": "How do next-token prediction objectives and model architecture contribute to LLMs producing plausible-sounding text without ensuring factual accuracy?", "is_followup": false}, {"id": "SQ2", "text": "How do training-data problems\u2014including inaccuracies, omissions, bias, duplication, and limited coverage\u2014cause or reinforce hallucinations?", "is_followup": false}, {"id": "SQ3", "text": "How do gaps or outdated information in a model\u2019s learned knowledge, and its inability to reliably recognize those gaps, lead to fabricated answers?", "is_followup": false}, {"id": "SQ4", "text": "How do prompting, ambiguous instructions, and insufficient or conflicting context affect hallucination rates?", "is_followup": false}, {"id": "SQ5", "text": "How can decoding choices, uncertainty calibration, and failures in retrieval or tool use contribute to unsupported claims?", "is_followup": false}]}, "evidence": [{"id": "S2-e1", "source_id": "S2", "sub_question_id": "SQ5", "claim": "Noisy external knowledge that conflicts with a model\u2019s parametric knowledge can degrade performance.", "quote": "However, the external knowledge may contain noise and conflict with the parametric knowledge of LLMs, leading to degraded performance.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.86, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e2", "source_id": "S2", "sub_question_id": "SQ5", "claim": "The proposed method uses intrinsic cognitive uncertainty to decide when to introduce external knowledge.", "quote": "An unsupervised hallucination detection method that captures the LLMs\u2019 intrinsic cognitive uncertainty ensures that external knowledge is introduced only when necessary.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.76, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e1", "source_id": "S1", "sub_question_id": "SQ1", "claim": "Next-token prediction rewards fluent, coherent text without directly penalizing factual errors, so plausible-sounding output is not necessarily accurate.", "quote": "The training objective of next-token prediction rewards fluency and coherence; it does not directly penalize factual incorrectness.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e2", "source_id": "S1", "sub_question_id": "SQ1", "claim": "The parametric architecture stores knowledge in distributed weights, leaving it static and opaque and making corrections difficult.", "quote": "A language model encodes knowledge in the distributed interactions of billions of parameters, which gives it impressive generalization ability but leaves that knowledge static and opaque, making corrections difficult.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e3", "source_id": "S1", "sub_question_id": "SQ3", "claim": "When information is missing, a model may fill the gap with convincing text based on loosely related training examples, without assurance that it is true.", "quote": "The model might fill in the gaps convincingly, drawing on patterns from loosely related training examples, but there's no guarantee those gap-fillings correspond to reality.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S1-e4", "source_id": "S1", "sub_question_id": "SQ3", "claim": "Information about events after the training cutoff is absent from the model's parameters, creating gaps in its learned knowledge.", "quote": "Information about events, discoveries, or changes that occurred after this date simply doesn't exist in the model's parameters.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S1-e5", "source_id": "S1", "sub_question_id": "SQ4", "claim": "Prompting cannot supply knowledge about post-cutoff events that was not present in the training data.", "quote": "No architectural optimization, no amount of clever prompting, and no post-training technique can generate knowledge about events that occurred after the training data was assembled.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.63, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e1", "source_id": "S5", "sub_question_id": "SQ2", "claim": "The source states that improving training-data quality decreases hallucinations and improves model reliability.", "quote": "Hence, by improving the data quality we are able to decrease the occurrence of hallucinations and thus improve the reliability of the LLMs for practical application in various areas including healthcare, finance, and law.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.91, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S3-e1", "source_id": "S3", "sub_question_id": "SQ2", "claim": "Overfitting to patterns or noise in training data can produce outputs that appear accurate but are incorrect.", "quote": "However, if they are overfitting to specific patterns or noise in the training data, they may generate outputs that seem accurate in some contexts but are fundamentally incorrect.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.86, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S3-e2", "source_id": "S3", "sub_question_id": "SQ2", "claim": "A model trained on clean, curated data may hallucinate when production data is messier or contains unfamiliar anomalies.", "quote": "An LLM trained in a lab environment using clean, curated datasets may hallucinate when deployed into production, where data is messier or contains anomalies the model was not exposed to during training.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.83, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S3-e3", "source_id": "S3", "sub_question_id": "SQ3", "claim": "When real-world data shifts from the training distribution, the model may rely on outdated patterns and hallucinate details.", "quote": "In such cases, the model is still operating based on patterns from outdated data, making it prone to hallucinating details or creating inaccurate outputs.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.91, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S3-e4", "source_id": "S3", "sub_question_id": "SQ3", "claim": "Without domain-specific training, a general-purpose model may hallucinate or provide irrelevant information on specialized questions.", "quote": "However, when tasked with generating medical advice, it could hallucinate details or produce irrelevant information because it has not been specifically trained to handle medical terminology or concepts.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.87, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S3-e5", "source_id": "S3", "sub_question_id": "SQ5", "claim": "Strict inference-time limits may prioritize speed over accuracy and lead the model to hallucinate to fill gaps in its reasoning.", "quote": "If an LLM is forced to generate predictions under stringent time limits, the result might be an incomplete or inaccurate output, where the model hallucinates to fill gaps in its reasoning.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.79, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S6-e1", "source_id": "S6", "sub_question_id": "SQ3", "claim": "When a model lacks current knowledge or live access, it may guess about post-cutoff events and present those guesses as facts instead of acknowledging uncertainty.", "quote": "Temporal hallucination (aka temporal misgrounding / prospective confabulation): a hallucination in which a model fabricates facts or events because its internal knowledge cutoff or lack of live access forces it to infer or guess about outcomes after that cutoff, and it expresses those inferred outcomes as factual rather than flagging uncertainty or ignorance.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S6-e2", "source_id": "S6", "sub_question_id": "SQ4", "claim": "The source recommends explicit temporal instructions in the system prompt to help prevent fabricated post-cutoff claims.", "quote": "Force temporal grounding in the system prompt \u2014 e.g. \u201cAlways state your knowledge cutoff and refuse to invent post-cutoff facts; if you lack web access, respond \u2018I don\u2019t know after [cutoff date]\u2019.\u201d", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.75, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S6-e3", "source_id": "S6", "sub_question_id": "SQ5", "claim": "The source identifies weak retrieval evidence as a signal associated with a higher likelihood of hallucination.", "quote": "Retrieval evidence score: Attempt to retrieve supporting sources (web.run or retrieval DB). Let ![S{\\text{retr}} \\in [0, 1]](https://s0.wp.com/latex.php?latex=S%7B%5Ctext%7Bretr%7D%7D+%5Cin+%5B0%2C+1%5D&bg=ffffff&fg=000&s=0&c=20201002) be normalized retrieval-match score (e.g., top-k evidence similarity + freshness). Low increases hallucination likelihood.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e1", "source_id": "S4", "sub_question_id": "SQ1", "claim": "The next-token objective trains a model to predict the most likely next token using preceding tokens as context.", "quote": "Next-Token Prediction is a fundamental training objective for language models that learns to predict the most likely subsequent token in a sequence given all preceding tokens as context.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.76, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S4-e2", "source_id": "S4", "sub_question_id": "SQ1", "claim": "Teacher forcing creates exposure bias because training conditions differ from free-running generation, and post-training can reduce that mismatch.", "quote": "Standard training uses teacher forcing: the model is conditioned on the ground-truth prefix rather than on its own earlier predictions, which produces exposure bias\u2014a mismatch between training conditions and free-running generation\u2014reduced afterwards by post-training stages that optimize the model on its own sampled outputs, such as reinforcement learning from human feedback.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.68, "citable": true, "query_id": "Q1", "cross_attributed": false}], "sources": [{"id": "S1", "url": "https://mbrenndoerfer.com/writing/rag-motivation-llm-knowledge-limitations", "title": "RAG Motivation: Solving Hallucinations & Knowledge Gaps - Interactive", "domain": "mbrenndoerfer.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.609, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S2", "url": "https://aclanthology.org/2025.emnlp-main.549", "title": "Bridging External and Parametric Knowledge: Mitigating Hallucination of LLMs with Shared-Private Semantic Synergy in Dual-Stream Knowledge - ACL Anthology", "domain": "aclanthology.org", "source_type": "academic", "content_origin": "provider_raw", "quality_score": 0.93, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S3", "url": "https://wallaroo.ai/llms-navigating-quality-control-for-reducing-hallucinations-and-bias", "title": "LLMs: Navigating Quality Control for Reducing Hallucinations and Bias | Wallaroo.AI", "domain": "wallaroo.ai", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.592, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S4", "url": "https://vstorm.co/glossary/next-token-prediction", "title": "Next-token prediction: how a language model actually learns | Vstorm Glossary", "domain": "vstorm.co", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.543, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S5", "url": "https://ijcaonline.org/archives/volume187/number4/impact-of-high-data-quality-on-llm-hallucinations", "title": "Impact of High Data Quality on LLM Hallucinations", "domain": "ijcaonline.org", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.593, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S6", "url": "https://champaignmagazine.com/2025/09/18/temporal-hallucination-a-mathematical-framework-for-detection-and-measurement", "title": "Temporal Hallucination: A Mathematical Framework for Detection and Measurement \u2013 Champaign Magazine", "domain": "champaignmagazine.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.585, "page_count": null, "usable": true, "fetch_status": "provider_content"}], "contract": {"question": "What are the main causes of hallucinations in large language models (LLMs)?", "question_type": "definition", "entities": ["Large language models (LLMs)", "Hallucination"], "dimensions": [], "constraints": [], "ambiguities": [], "usable": true, "unusable_reason": "", "required_slots": [{"name": "definition", "description": "What the subject is", "core": true, "satisfied_by": []}, {"name": "distinguishing_property", "description": "What separates it from adjacent things", "core": false, "satisfied_by": []}]}, "verification": {"total_claims": 0, "substantive_claims": 0, "total_citations": 0, "resolvable_citations": 0, "total_evidence_refs": 0, "resolvable_evidence_refs": 0, "supported_claims": 0, "partially_supported_claims": 0, "unsupported_claims": 4, "c