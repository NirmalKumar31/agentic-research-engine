data: {"run_id": "20260930-230347-f50f28", "report": {"title": "Does label noise cause deep neural networks to overfit?", "summary_claims": [], "key_findings": [], "sections": [{"heading": "Mechanism and intervention", "claims": [{"text": "Stopping training before a model begins memorizing noise in its training data improves generalization.", "kind": "factual", "answer_slot": "effect_direction", "evidence_ids": ["S5-e1"], "citation_ids": ["S5"]}]}], "contradictions": [], "limitations": ["The supplied evidence does not establish the strength of the causal effect in controlled experiments. The reported clean-versus-noisy test-accuracy gap does not include experimental-design details or a numerical effect size.", "The evidence does not establish how the effect varies across network architectures or across different noise structures.", "Only limited evidence was found for: In controlled experiments, does adding incorrect labels cause deep neural networks to achieve worse generalization than training on clean labels, and how strong is the causal evidence.", "Only limited evidence was found for: Through what mechanisms and under what conditions\u2014such as model capacity, training duration, and optimization dynamics\u2014do deep networks memorize noisy labels.", "Only limited evidence was found for: How do noise type and structure, including noise rate, class-dependent noise, and instance-dependent noise, affect whether networks overfit.", "Only limited evidence was found for: What evidence distinguishes overfitting to label noise from ordinary generalization error, including training and test performance patterns and memorization measures.", "Only limited evidence was found for: Which factors or interventions\u2014such as early stopping, regularization, data augmentation, or robust-loss methods\u2014prevent or weaken noise-driven overfitting, and when can it persist despite them.", "4 extracted finding(s) were excluded because their quotes could not be located in the source text", "4 generated claim(s) were excluded because the cited evidence did not support them, or because verification did not reach them within this run's budget.", "This research did not answer the question. Nothing published establishes a cause; what survived describes what happened without showing why.", "The evidence did not establish what the evidence cannot establish about cause."]}, "plan": {"sub_questions": [{"id": "SQ1", "text": "In controlled experiments, does adding incorrect labels cause deep neural networks to achieve worse generalization than training on clean labels, and how strong is the causal evidence?", "is_followup": false}, {"id": "SQ2", "text": "Through what mechanisms and under what conditions\u2014such as model capacity, training duration, and optimization dynamics\u2014do deep networks memorize noisy labels?", "is_followup": false}, {"id": "SQ3", "text": "How do noise type and structure, including noise rate, class-dependent noise, and instance-dependent noise, affect whether networks overfit?", "is_followup": false}, {"id": "SQ4", "text": "What evidence distinguishes overfitting to label noise from ordinary generalization error, including training and test performance patterns and memorization measures?", "is_followup": false}, {"id": "SQ5", "text": "Which factors or interventions\u2014such as early stopping, regularization, data augmentation, or robust-loss methods\u2014prevent or weaken noise-driven overfitting, and when can it persist despite them?", "is_followup": false}]}, "evidence": [{"id": "S1-e1", "source_id": "S1", "sub_question_id": "SQ1", "claim": "The survey reports a test-accuracy gap between models trained on clean and noisy data, even when the listed regularization techniques are used.", "quote": "As shown in Figure 1, the gap in test accuracy between models trained on clean and noisy data remains significant even though all of the aforementioned regularization techniques are activated.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S1-e2", "source_id": "S1", "sub_question_id": "SQ2", "claim": "The survey attributes networks\u2019 tendency to overfit corrupted labels partly to their large number of parameters and capacity to learn complex functions.", "quote": "In the presence of noisy labels, training DNNs is known to be susceptible to noisy labels because of the significant number of model parameters that render DNNs overfit to even corrupted labels with the capability of learning any complex function [20, 21].", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e3", "source_id": "S1", "sub_question_id": "SQ2", "claim": "The survey says DNNs can fit corrupted labels across any corruption ratio, consistent with memorization of noisy training labels.", "quote": "Zhang et al. [22] demonstrated that DNNs can easily fit an entire training dataset with any ratio of corrupted labels, which eventually resulted in poor generalizability on a test dataset.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.92, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e4", "source_id": "S1", "sub_question_id": "SQ3", "claim": "The survey says DNNs can fit the training data at any ratio of corrupted labels, though this passage does not compare how different ratios affect overfitting.", "quote": "Zhang et al. [22] demonstrated that DNNs can easily fit an entire training dataset with any ratio of corrupted labels, which eventually resulted in poor generalizability on a test dataset.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.7, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e5", "source_id": "S1", "sub_question_id": "SQ3", "claim": "The survey identifies instance-dependent noise as an under-investigated structure, attributing this in part to the complexity of modeling it.", "quote": "Most existing algorithms dealt with instance-independent noise, but instance-dependent noise has not yet been extensively investigated owing to its complex modeling.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.86, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e6", "source_id": "S1", "sub_question_id": "SQ3", "claim": "The survey states that label-corruption probability depends on the relationship between data features or class labels.", "quote": "Even if data labels are corrupted from ground-truth labels without any prior assumption, in essence, the corruption probability is affected by the dependency between data features or class labels.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.82, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e1", "source_id": "S2", "sub_question_id": "SQ5", "claim": "The paper proposes augmenting the prediction objective with a consistency criterion based on similarity between deep-network features as a way to handle noisy and incomplete labels.", "quote": "A generic way to handle noisy and incomplete labeling by augmenting the prediction objective with a notion of consistency is proposed, which considers a prediction consistent if the same prediction is made given similar percepts, where the notion of similarity is between deep network features computed from the input data.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.7, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S6-e1", "source_id": "S6", "sub_question_id": "SQ1", "claim": "The source says noisy or incorrect labels prompt networks to memorize training labels, which degrades generalization.", "quote": "In the presence of noisy or incorrect labels, networks start to memorize the training la- bels, which degrades the generalization performance ( Chen et al., 2019).", "quote_match": "exact_normalized", "page": 1, "stance": "supports", "confidence": 0.88, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S6-e2", "source_id": "S6", "sub_question_id": "SQ2", "claim": "The source identifies label-noise information stored in weights as a mechanism of memorization and says cross-entropy can reward that information.", "quote": "Surprisingly, cross-entropy rewards large values of I(w; y | x), which may promote memorization if labels contain information beyond what can be inferred from x.", "quote_match": "fuzzy", "page": 2, "stance": "supports", "confidence": 0.384, "citable": false, "query_id": "", "cross_attributed": true}, {"id": "S6-e3", "source_id": "S6", "sub_question_id": "SQ2", "claim": "The source says memorization depends not only on representational capacity but also on the loss function or learning algorithm.", "quote": "Such a result highlights that in addition to the network\u2019s representational capabilities, the loss function \u2013 or more generally, the learning algorithm \u2013 plays an important role in memorization.", "quote_match": "fuzzy", "page": 2, "stance": "supports", "confidence": 0.332, "citable": false, "query_id": "", "cross_attributed": true}, {"id": "S6-e4", "source_id": "S6", "sub_question_id": "SQ3", "claim": "The source gives an example of uniform incorrect-label noise at an 80% rate.", "quote": "For example, consider a corrupted version of the MNIST dataset where each label is changed with probability 0.8 to a uniformly random incorrect label.", "quote_match": "fuzzy", "page": 3, "stance": "supports", "confidence": 0.348, "citable": false, "query_id": "", "cross_attributed": true}, {"id": "S6-e5", "source_id": "S6", "sub_question_id": "SQ4", "claim": "The source reports that standard architectures can fit even randomly assigned training labels, illustrating that training accuracy alone can conceal label memorization.", "quote": "At the extreme, standard architectures have the capacity to achieve 100% classi\ufb01cation accuracy on training data, even when labels are assigned at random (Zhang et al., 2016).", "quote_match": "none", "page": null, "stance": "supports", "confidence": 0.137, "citable": false, "query_id": "", "cross_attributed": true}, {"id": "S6-e6", "source_id": "S6", "sub_question_id": "SQ4", "claim": "The source defines label memorization in terms of mutual information between the weights and training labels, conditioned on inputs.", "quote": "The amount of label memorization is then given by the Shannon mutual information between weights and labels conditioned on inputs, I(w; y | x).", "quote_match": "exact_normalized", "page": 2, "stance": "supports", "confidence": 0.96, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e1", "source_id": "S5", "sub_question_id": "SQ2", "claim": "The source says continued training can lead a model to memorize training-data noise, and stopping training earlier can improve generalization.", "quote": "Stops training before the model begins memorizing noise in the training data, improving generalization.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.76, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e2", "source_id": "S5", "sub_question_id": "SQ4", "claim": "The source describes a pattern in which training loss keeps falling while validation loss eventually stops improving, which it uses to explain when early stopping occurs.", "quote": "The graph shows that:\n\n The training loss continuously decreases with each epoch.\n The validation loss decreases initially but eventually stops improving.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.76, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e3", "source_id": "S5", "sub_question_id": "SQ5", "claim": "The source presents early stopping based on validation performance as a way to prevent overfitting and reduce unnecessary training.", "quote": "Early stopping is a simple and effective regularization technique that monitors a model's performance on a validation dataset during training. Instead of training for a fixed number of epochs, it automatically stops training when the validation metric no longer improves. This helps prevent overfitting and saves computational resources.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.93, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S5-e4", "source_id": "S5", "sub_question_id": "SQ5", "claim": "The source cautions that early stopping can underfit or overfit if its patience setting is inappropriate.", "quote": "Choosing an inappropriate patience value can lead to underfitting or overfitting.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.79, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S5-e5", "source_id": "S5", "sub_question_id": "SQ5", "claim": "The source notes that fluctuations in validation metrics can make early-stopping decisions inconsistent.", "quote": "Validation metrics may fluctuate, causing inconsistent stopping decisions.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.74, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S4-e1", "source_id": "S4", "sub_question_id": "SQ1", "claim": "The source reports that test accuracy declines as label-noise rates increase, approximately linearly at moderate rates and more rapidly as noise grows.", "quote": "The relationship between label noise rate and model accuracy is roughly linear in the moderate range and accelerates as noise grows.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e2", "source_id": "S4", "sub_question_id": "SQ2", "claim": "The source says deep networks can memorize incorrect labels because training pushes them to match the supplied labels, including wrong answers.", "quote": "Modern deep networks have enough capacity to fit almost any labeling, including random noise. During training, the loss function pushes the model to match the labels it's given. If 8% of those labels are wrong, the model dutifully learns the wrong answer for 8% of the input space.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e3", "source_id": "S4", "sub_question_id": "SQ2", "claim": "The source attributes stronger noise overfitting in larger models to their greater capacity to memorize.", "quote": "Bigger models have more capacity to memorize noise, so they overfit to label errors more aggressively.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e4", "source_id": "S4", "sub_question_id": "SQ3", "claim": "The source reports that structured geospatial label errors degraded classification performance about five times more than random errors at the same overall noise rate.", "quote": "A widely cited 2017 remote-sensing study compared random mislabeling with geospatial mislabeling (a structured form caused by coarse polygon boundaries that included undamaged sidewalk pixels as \"rubble\"). The structured errors degraded classification performance roughly five times more than random errors at the same overall noise rate.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e5", "source_id": "S4", "sub_question_id": "SQ3", "claim": "The source says class-dependent and instance-dependent noise can pull decision boundaries consistently in a particular direction.", "quote": "With class-dependent or instance-dependent noise, the bend is consistent; the boundary doesn't just get fuzzier, it drifts in a specific direction.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.92, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e6", "source_id": "S4", "sub_question_id": "SQ4", "claim": "The source distinguishes memorization from generalization by describing noise memorization as leading to confident but incorrect real-world predictions.", "quote": "This is memorization, not generalization, and it shows up later as confident but incorrect predictions on real-world data.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.94, "citable": true, "query_id": "Q4", "cross_attributed": false}], "sources": [{"id": "S1", "url": "https://arxiv.org/html/2007.08199v7", "title": "Learning from Noisy Labels with Deep Neural Networks: A Survey", "domain": "arxiv.org", "source_type": "academic", "content_origin": "provider_raw", "quality_score": 0.96, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S2", "url": "https://www.semanticscholar.org/paper/Training-Deep-Neural-Networks-on-Noisy-Labels-with-Reed-Lee/77e3c48aa10535276e7f570a3af594ba63de7d65", "title": "[PDF] Training Deep Neural Networks on Noisy Labels with Bootstrapping | Semantic Scholar", "domain": "semanticscholar.org", "source_type": "academic", "content_origin": "provider_raw", "quality_score": 0.948, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S3", "url": "https://dl.acm.org/doi/10.1145/3711896.3737376", "title": "Delving into Instance-Dependent Label Noise in Graph Data", "domain": "dl.acm.org", "source_type": "academic", "content_origin": "none", "quality_score": 0.0, "page_count": null, "usable": false, "fetch_status": "http_error"}, {"id": "S4", "url": "https://www.sitepoint.com/what-happens-when-ai-learns-from-incorrect-labels-the-hidden-cost-of-noisy-training-data", "title": "What Happens When AI Learns From Incorrect Labels: The Hidden Cost of Noisy Training Data", "domain": "sitepoint.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.609, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S5", "url": "https://www.geeksforgeeks.org/machine-learning/regularization-by-early-stopping", "title": "Regularization by Early Stopping - GeeksforGeeks", "domain": "geeksforgeeks.org", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.613, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S6", "url": "http://proceedings.mlr.press/v119/harutyunyan20a/harutyunyan20a.pdf", "title": "Improving Generalization by Controlling Label-Noise ...", "domain": "proceedings.mlr.press", "source_type": "other", "content_origin": "pdf_extract", "quality_score": 0.616, "page_count": 3, "usable": true, "fetch_status": "ok"}], "contract": {"question": "Does label noise cause deep neural networks to overfit their training data?", "question_type": "causal", "entities": ["Label noise", "Deep neural networks", "Training data"], "comparison_subjects": [], "shape_source": "wording", "dimensions": [], "constraints": [], "ambiguities": [], "usable": true, "unusable_reason": "", "required_slots": [{"name": "causal_evidence", "description": "Evidence capable of supporting the causal relationship, not association", "core": true, "satisfied_by": []}, {"name": "effect_direction", "description": "Which way the relationship runs", "core": false, "satisfied_by": []}, {"name": "limitations", "description": "What the evidence cannot establish about cause", "core": false, "satisfied_by": []}]}, "verification": {"total_claims": 1, "substantive_claims": 1, "total_citations": 1, "resolvable_citations": 1, "total_evidence_refs": 1, "resolva