data: {"run_id": "20260930-041038-97a9f4", "report": {"title": "Practical LoRA Fine-Tuning: Supported Steps and Evidence Gaps", "summary_claims": [{"text": "With QLoRA, the frozen base model is loaded in 4-bit precision using NF4.", "kind": "factual", "answer_slot": "steps", "evidence_ids": ["S2-e3"], "citation_ids": ["S2"]}], "key_findings": [], "sections": [], "contradictions": [], "limitations": ["The evidence does not establish how to split data, prevent leakage, or ensure that examples preserve the model\u2019s expected input and output structure.", "The evidence does not provide specific guidance for tokenization, batching, learning rate, sequence length, optimizer selection, checkpointing, or monitoring training failures.", "The evidence does not establish how to choose target modules, alpha, or dropout for a particular task.", "The evaluation evidence gives one benchmark result but does not establish a general evaluation procedure, task-appropriate metrics, or methods for detecting overfitting, regressions, or misleading results.", "The evidence does not establish how to save, version, load, or merge adapters, or how to test inference compatibility, deployment constraints, and reproducibility.", "The retrieved evidence did not answer: After training, how should adapters be saved, versioned, loaded or merged with the base model, and tested for inference compatibility, deployment constraints, and reproducibility.", "Only limited evidence was found for: How should training and validation data be selected, cleaned, deduplicated, formatted, and split to match the target task while preventing leakage and preserving the model\u2019s expected input and output structure.", "Only limited evidence was found for: How should a LoRA-tuned model be evaluated against the base model using task-appropriate metrics and representative examples, and how can overfitting, regressions, and misleading evaluation results be detected.", "Only limited evidence was found for: What base-model and LoRA adapter choices matter in practice, including rank, target modules, scaling, dropout, and whether to use quantization, and how should they be selected for the task and hardware budget.", "Only limited evidence was found for: What are the practical steps and training settings for fine-tuning LoRA adapters, including tokenization, batching, learning rate, sequence length, optimizer, checkpoints, and monitoring for common training failures.", "1 extracted finding(s) were excluded because their quotes could not be located in the source text", "3 generated claim(s) were excluded because the cited evidence did not support them, or because verification did not reach them within this run's budget.", "The evidence did not establish what must be true before starting."]}, "plan": {"sub_questions": [{"id": "SQ1", "text": "How should training and validation data be selected, cleaned, deduplicated, formatted, and split to match the target task while preventing leakage and preserving the model\u2019s expected input and output structure?", "is_followup": false}, {"id": "SQ2", "text": "What base-model and LoRA adapter choices matter in practice, including rank, target modules, scaling, dropout, and whether to use quantization, and how should they be selected for the task and hardware budget?", "is_followup": false}, {"id": "SQ3", "text": "What are the practical steps and training settings for fine-tuning LoRA adapters, including tokenization, batching, learning rate, sequence length, optimizer, checkpoints, and monitoring for common training failures?", "is_followup": false}, {"id": "SQ4", "text": "How should a LoRA-tuned model be evaluated against the base model using task-appropriate metrics and representative examples, and how can overfitting, regressions, and misleading evaluation results be detected?", "is_followup": false}, {"id": "SQ5", "text": "After training, how should adapters be saved, versioned, loaded or merged with the base model, and tested for inference compatibility, deployment constraints, and reproducibility?", "is_followup": false}]}, "evidence": [{"id": "S3-e1", "source_id": "S3", "sub_question_id": "SQ2", "claim": "Rank should balance adaptation capacity against compute, memory use, and overfitting risk.", "quote": "A rank that is too low might not capture the complexity your task requires; a rank that is too high wastes compute and memory while potentially overfitting.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S3-e2", "source_id": "S3", "sub_question_id": "SQ2", "claim": "Alpha controls how strongly the adapter influences the pretrained model\u2019s behavior.", "quote": "A high alpha means the adapter's output dominates, strongly overriding the pre-trained model's behavior. A low alpha means the adapter whispers its suggestions, making conservative modifications that preserve most of the original computation.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.94, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S3-e3", "source_id": "S3", "sub_question_id": "SQ2", "claim": "The choice of layers to target is task-dependent, and the roles of attention and feed-forward components can inform that choice.", "quote": "This choice turns out to be highly task-dependent, and understanding the role of each component helps you reason about the best targeting strategy.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.92, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S3-e4", "source_id": "S3", "sub_question_id": "SQ2", "claim": "LoRA can reduce hardware requirements enough that adaptation of a 7B-parameter model may be feasible on a single GPU with 16GB or less memory.", "quote": "This efficiency is why LoRA enables fine-tuning on consumer hardware: where full fine-tuning of a 7B parameter model might require multiple high-end GPUs, LoRA adaptation can often be accomplished on a single GPU with 16GB or even less memory.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.86, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S2-e1", "source_id": "S2", "sub_question_id": "SQ2", "claim": "Choose a base model based on its existing instruction-following ability and whether its license permits the intended use, not just benchmark scores.", "quote": "Two things matter more than raw benchmark scores when picking a base model for a LoRA fine tuning project: how well the model already follows instructions in its base instruct-tuned form, and whether its license permits your intended use, since some open-weight releases restrict commercial deployment above a certain user count.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.94, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e2", "source_id": "S2", "sub_question_id": "SQ2", "claim": "Rank involves a tradeoff: lower rank is smaller and faster but limits behavioral change, while higher rank offers more capacity and may increase overfitting risk on small datasets.", "quote": "The size of that update is controlled by a single number: the rank, written as r. A small r keeps the adapter tiny and fast to train but limits how much the model\u2019s behavior can shift. A larger r gives the adapter more room to learn, at the cost of more trainable parameters and a higher risk of overfitting on a small dataset.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e3", "source_id": "S2", "sub_question_id": "SQ2", "claim": "QLoRA uses 4-bit NF4 weights for the frozen base model and higher-precision adapter computation to reduce memory needs.", "quote": "Instead of loading the frozen base model at its native 16-bit precision, QLoRA loads it in 4-bit precision using a quantization format called NF4, then trains the LoRA adapter on top of the quantized weights while keeping the adapter\u2019s own math in a higher-precision dtype like bfloat16.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.96, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e4", "source_id": "S2", "sub_question_id": "SQ2", "claim": "The source presents QLoRA as a way to make fine-tuning 8B or 13B models feasible on a single 24GB consumer GPU.", "quote": "The base model\u2019s memory footprint drops by roughly 4x compared with 16-bit loading, which is what makes fine-tuning an 8B or even 13B model realistic on a single 24GB consumer GPU instead of a data-center card.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.94, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e5", "source_id": "S2", "sub_question_id": "SQ3", "claim": "Check CUDA compatibility and GPU capacity because the source identifies mismatched CUDA builds and undersized GPUs as frequent causes of fine-tuning failures.", "quote": "Fine-tuning jobs fail more often from a mismatched CUDA build or an undersized GPU than from anything in the actual script.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.78, "citable": true, "query_id": "Q6", "cross_attributed": false}, {"id": "S2-e6", "source_id": "S2", "sub_question_id": "SQ4", "claim": "The source reports a benchmark comparison in which a LoRA adapter improved Llama-3.1-8B accuracy over the base model on financial datasets.", "quote": "The gains from adapting it aren\u2019t just theoretical, either: Open-Finance-Lab\u2019s FinLoRA benchmark, published May 2025, found a LoRA adapter lifted Llama-3.1-8B\u2019s accuracy by 37.69 points over the base model, part of a broader evaluation that tested multiple LoRA methods across several base LLMs on numerous financial datasets.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.78, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e1", "source_id": "S1", "sub_question_id": "SQ2", "claim": "LoRA freezes the base-model weights and trains additional adapter weights represented through a rank-and-matrix decomposition, but the source does not explain how to choose a rank or other adapter settings.", "quote": "So all the model weights is going to be freeze and we are going to be add some additional weight uh to the model and those weight only we are going to train.", "quote_match": "fuzzy", "page": null, "stance": "supports", "confidence": 0.272, "citable": false, "query_id": "Q4", "cross_attributed": false}, {"id": "S6-e1", "source_id": "S6", "sub_question_id": "SQ2", "claim": "QLoRA stores the frozen base model in 4-bit precision while training LoRA adapters in full precision.", "quote": "QLoRA (Quantized LoRA) solves this problem by storing the frozen base model in 4-bit precision while training LoRA adapters in full precision.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S6-e2", "source_id": "S6", "sub_question_id": "SQ2", "claim": "The source says QLoRA can enable fine-tuning a 65-billion-parameter model on a 48 GB GPU without meaningful loss in final performance.", "quote": "A 65-billion parameter model that would require 130 GB of memory in FP16 can be fine-tuned on a single 48 GB GPU using QLoRA, with no meaningful loss in final performance.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.96, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S6-e3", "source_id": "S6", "sub_question_id": "SQ2", "claim": "Typical LoRA settings described in the source use rank 8\u201364 and target attention layers.", "quote": "With typical settings (rank 8-64 targeting attention layers), the adapters constitute roughly 0.1-1% of base model parameters.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.94, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S6-e4", "source_id": "S6", "sub_question_id": "SQ2", "claim": "The source identifies NF4, double quantization, and paged optimizers as techniques for addressing accuracy, quantization-metadata overhead, and memory stability, respectively.", "quote": "The key innovations behind QLoRA are a new 4-bit data type called NormalFloat (NF4) that is optimized for normally distributed weights, double quantization to minimize the storage overhead of quantization bookkeeping, and paged optimizers that gracefully handle memory spikes during training.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.91, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S6-e5", "source_id": "S6", "sub_question_id": "SQ3", "claim": "The source notes that Adam optimizer states require 8 bytes per trainable parameter in FP32, while LoRA keeps this cost manageable by training relatively few parameters.", "quote": "Optimizer states for Adam-based optimizers store momentum and variance estimates for each trainable parameter. In FP32, this requires 8 bytes per trainable parameter (4 for momentum, 4 for variance).", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.75, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S6-e6", "source_id": "S6", "sub_question_id": "SQ3", "claim": "Gradient checkpointing can reduce activation memory by recomputing activations during the backward pass, at the cost of additional computation.", "quote": "Gradient checkpointing can reduce this cost by recomputing activations during the backward pass, trading computation for memory.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.77, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e1", "source_id": "S4", "sub_question_id": "SQ1", "claim": "The source recommends selecting high-quality examples relevant to the target task, removing duplicates, balancing class distributions where applicable, and validating format consistency.", "quote": "Dataset curation: - Filter for high-quality examples relevant to target task - Remove duplicates and near-duplicates - Balance class distributions if applicable - Validate data format consistency", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e2", "source_id": "S4", "sub_question_id": "SQ1", "claim": "The source gives example dataset-size ranges but does not specify how to split data or prevent leakage.", "quote": "Minimum viable: 1,000-5,000 high-quality examples - Production baseline: 10,000-50,000 examples - Domain expertise capture: 50,000-500,000 examples", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.65, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e3", "source_id": "S4", "sub_question_id": "SQ2", "claim": "The example LoRA configuration uses rank 16, scaling factor 32, q/k/v/o projection targets, and dropout 0.05.", "quote": "loraconfig = LoraConfig(r = 16, # Rank loraalpha = 32, # Scaling factor targetmodules =[", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S4-e4", "source_id": "S4", "sub_question_id": "SQ2", "claim": "The source presents QLoRA as a way to fine-tune models that otherwise would not fit in available memory.", "quote": "QLoRA combines LoRA with aggressive base model quantization, enabling fine-tuning of models that wouldn't otherwise fit in memory:", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S4-e5", "source_id": "S4", "sub_question_id": "SQ2", "claim": "The source says QLoRA\u2019s quantization noise affects tasks differently and that target-task evaluation should determine whether its quality tradeoff is acceptable.", "quote": "Quality tradeoff: QLoRA achieves 80-90% of full fine-tuning quality. The additional quantization noise affects some tasks more than others; evaluation on target tasks determines acceptability.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S4-e6", "source_id": "S4", "sub_question_id": "SQ2", "claim": "For 7B QLoRA fine-tuning, the source lists an RTX 3090 24GB or RTX 4080 16GB as minimum hardware and an RTX 4090 24GB as recommended.", "quote": "QLoRA fine-tuning: - Minimum: RTX 3090 24GB or RTX 4080 16GB - Recommended: RTX 4090 24GB - Memory requirement: 12-20GB\u2075", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S5-e1", "source_id": "S5", "sub_question_id": "SQ2", "claim": "QLoRA reduces memory use by keeping most base-model weights at 4-bit while training only a small fraction of the parameters.", "quote": "QLoRA allows you to update only a tiny fraction of the model\u2019s parameters while keeping the vast majority of the weights stored and loaded in memory at 4-bit, saving enormous amounts of VRAM.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S5-e2", "source_id": "S5", "sub_question_id": "SQ2", "claim": "In the described QLoRA setup, the base weights remain frozen in 4-bit, while the adapter matrices are trainable and kept at higher precision.", "quote": "Only the small adapter matrices (A and B) are trainable and stored in high precision (BF16/FP16).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.85, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S5-e3", "source_id": "S5", "sub_question_id": "SQ2", "claim": "The source recommends weighing quantization\u2019s efficiency gains against its potential impact on output quality when deciding whether to use it.", "quote": "Therefore, the adoption of low-precision quantization hinges entirely on a cost-benefit analysis: if the potential negative impact on business or usage quality is deemed acceptable given the significant gains in efficiency and environmental friendliness, then it represents a highly viable and sustainable approach to deploying Generative AI.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.8, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S5-e4", "source_id": "S5", "sub_question_id": "SQ2", "claim": "The source warns that 4-bit quantization can reduce precision and lead to unexpected or substandard outputs.", "quote": "The core idea is that while reducing a Large Language Model (LLM) to lower precision (like 4-bit) dramatically improves sustainability by reducing hardware and energy requirements, this method carries inherent risks, primarily a loss of precision that could lead to unexpected or substandard model outputs (i.e., \u201cgoing sideways\u201d).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.8, "citable": true, "query_id": "Q4", "cross_attributed": false}, {"id": "S5-e5", "source_id": "S5", "sub_question_id": "SQ3", "claim": "The source identifies PEFT for LoRA functionality and the datasets library for training data as dependencies for its QLoRA implementation.", "quote": "Additional Dependencies: we need the peft library for the LoRA configuration and functionality, and datasets for training data.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.55, "citable": true, "query_id": "", "cross_attributed": true}], "sources": [{"id": "S1", "url": "https://www.youtube.com/watch?v=cO6Ly7mIziQ", "title": "LoRA & QLoRA Explained Simply | Full Fine-Tuning vs PEFT + Intuition + Practical (Complete Guide)", "domain": "youtube.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.606, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S2", "url": "https://tech-insider.org/how-to-fine-tune-llm-lora-2026", "title": "How to Fine-Tune an LLM With LoRA: 12 Steps [2026]", "domain": "tech-insider.org", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.607, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S3", "url": "https://mbrenndoerfer.com/writing/lora-hyperparameters-rank-alpha-target-modules", "title": "LoRA Hyperparameters: Rank, Alpha & Target Module Selection - Interactive", "domain": "mbrenndoerfer.com", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.619, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S4", "url": "https://introl.com/blog/fine-tuning-infrastructure-lora-qlora-peft-scale-guide-2025", "title": "Fine-Tuning Infrastructure: LoRA, QLoRA, and PEFT at Scale | Introl Blog", "domain": "introl.com", "source_type": "blog", "content_origin": "provider_raw", "quality_score": 0.559, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S5", "url": "https://dev.to/aairom/run-big-llms-on-small-gpus-a-hands-on-guide-to-4-bit-quantization-and-qlora-4bi", "title": "Run Big LLMs on Small GPUs: A Hands-On Guide to 4-bit Quantization and QLoRA - DEV Community", "domain": "dev.to", "source_type": "blog", "content_origin": "provider_raw", "quality_score": 0.55, "page_count": null, "usable