data: {"run_id": "20260928-045059-c27d6a", "report": {"title": "Empirical measures of AI coding assistant productivity", "summary_claims": [], "key_findings": [], "sections": [], "contradictions": [], "limitations": ["The supplied evidence does not establish whether measured productivity effects persist beyond short tasks or initial use.", "The supplied evidence does not establish the general effects of AI coding assistants across task types: one cited experiment used a single JavaScript task, and the available task comparisons are limited.", "The supplied evidence does not establish whether time savings generally come with changes in code correctness, maintainability, security, or rework.", "Only limited evidence was found for: How strong and generalizable is the evidence, considering study design, sample size, controlled versus real-world settings, and whether measured gains persist beyond short tasks or initial use.", "Only limited evidence was found for: How do measured effects differ across task types and difficulty, such as code generation, debugging, documentation, or unfamiliar codebases.", "Only limited evidence was found for: How do findings differ across productivity and quality measures\u2014such as time, task completion, code correctness, defects, maintainability, and rework\u2014and do gains on one measure come with losses on another.", "6 generated claim(s) were excluded because the cited evidence did not support them, or because verification did not reach them within this run's budget.", "1 reported disagreement(s) were excluded because the evidence did not support both sides as stated."]}, "plan": {"sub_questions": [{"id": "SQ1", "text": "Across empirical studies comparing AI coding assistants with unaided work, what changes in measured completion time, output, or overall productivity, and how consistent are the effect estimates?", "is_followup": false}, {"id": "SQ2", "text": "How do measured effects differ across task types and difficulty, such as code generation, debugging, documentation, or unfamiliar codebases?", "is_followup": false}, {"id": "SQ3", "text": "How do effects vary with developers\u2019 experience or skill level, including whether less- and more-experienced developers benefit differently?", "is_followup": false}, {"id": "SQ4", "text": "How do findings differ across productivity and quality measures\u2014such as time, task completion, code correctness, defects, maintainability, and rework\u2014and do gains on one measure come with losses on another?", "is_followup": false}, {"id": "SQ5", "text": "How strong and generalizable is the evidence, considering study design, sample size, controlled versus real-world settings, and whether measured gains persist beyond short tasks or initial use?", "is_followup": false}]}, "evidence": [{"id": "S1-e1", "source_id": "S1", "sub_question_id": "SQ1", "claim": "In this controlled experiment, developers using Copilot completed the task 55.8% faster, with a wide 95% confidence interval of 21% to 89%.", "quote": "The treated group completed the task 55.8% faster (95% confidence interval: 21-89%).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S1-e2", "source_id": "S1", "sub_question_id": "SQ1", "claim": "Among participants who completed the task, average completion time was 71.17 minutes with Copilot and 160.89 minutes without it.", "quote": "Conditioning on completing the task, the average completion time from the treated group is 71.17 minutes and 160.89 minutes for the control group.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S1-e3", "source_id": "S1", "sub_question_id": "SQ2", "claim": "The study compared Copilot with unaided work on one specified task: implementing an HTTP server in JavaScript, rather than comparing effects across task types.", "quote": "Participants were instructed to write an HTTP server in JavaScript\u2014the treatment group would use GitHub Copilot to complete the task, while the control group would not.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.55, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e4", "source_id": "S1", "sub_question_id": "SQ3", "claim": "The study reports that less-experienced developers, developers who coded more hours per day, and developers aged 25 to 44 benefited more from Copilot.", "quote": "The results show that less experienced developers (years of professional coding), developers with heavy coding load (hours of coding per day), and older developers (developers aged between 25 and 44) benefit more from Copilot.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.97, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e5", "source_id": "S1", "sub_question_id": "SQ4", "claim": "The study measured task completion time and task success, and the estimated 7-percentage-point increase in success was not statistically significant.", "quote": "We also find that the treated group\u2019s success rate is 7 percentage points higher than the control group, but the estimate is not statistically significant, with a 95% confidence interval of [-0.11, 0.25].", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.96, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S1-e6", "source_id": "S1", "sub_question_id": "SQ4", "claim": "The study operationalized performance using task success and completion time, with correctness also checked using a 12-test suite.", "quote": "We calculated two metrics as a measure of performance for each group: task success and task completion time.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.87, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S3-e1", "source_id": "S3", "sub_question_id": "SQ1", "claim": "In this controlled experiment, developers with Copilot completed the task 55.8% faster, with a reported 95% confidence interval of 21\u201389%.", "quote": "Developers with access to Copilot completed the programming task 55.8% faster than those without access (95% confidence interval: 21-89%).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S3-e2", "source_id": "S3", "sub_question_id": "SQ1", "claim": "The reported productivity improvement was measured on one programming task, so the source does not establish how consistent the effect is across different studies or tasks.", "quote": "The experiment involved a single programming task in JavaScript. Future research should explore different programming languages and more complex tasks.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.8, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S3-e3", "source_id": "S3", "sub_question_id": "SQ2", "claim": "The study tested a single JavaScript HTTP-server task and calls for research on other languages and more complex tasks, so it does not compare effects across task types or difficulty levels.", "quote": "The experiment involved a single programming task in JavaScript. Future research should explore different programming languages and more complex tasks.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S3-e4", "source_id": "S3", "sub_question_id": "SQ3", "claim": "The source reports that developers with less programming experience benefited more from Copilot than those with extensive experience.", "quote": "Developers with less programming experience benefited more from Copilot than those with extensive experience.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S3-e5", "source_id": "S3", "sub_question_id": "SQ4", "claim": "The treatment group had a higher task-success rate, but the difference was not statistically significant, so the reported time gain did not correspond to a statistically established success-rate gain.", "quote": "While the treatment group had a higher success rate than the control group, this difference was not statistically significant.", "quote_match": "exact_normalized", "page": null, "stance": "contradicts", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S3-e6", "source_id": "S3", "sub_question_id": "SQ4", "claim": "The study measured task completion time rather than code quality, leaving quality outcomes such as maintainability and correctness unassessed.", "quote": "The study focused on task completion time rather than code quality. Additional research is needed to assess how AI tools affect code quality, maintainability, and security.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e1", "source_id": "S4", "sub_question_id": "SQ1", "claim": "In the controlled experiment, developers using Copilot completed the task 55% faster on average, though the reported confidence interval spans speed gains from 21% to 89%.", "quote": "The striking difference was that developers who used GitHub Copilot completed the task significantly faster\u201355% faster than the developers who didn\u2019t use GitHub Copilot. Specifically, the developers using GitHub Copilot took on average 1 hour and 11 minutes to complete the task, while the developers who didn\u2019t use GitHub Copilot took on average 2 hours and 41 minutes.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S4-e2", "source_id": "S4", "sub_question_id": "SQ1", "claim": "The reported speed result was statistically significant, with a 95% confidence interval ranging from 21% to 89%.", "quote": "These results are statistically significant (P=.0017) and the 95% confidence interval for the percentage speed gain is [21%, 89%].", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S4-e3", "source_id": "S4", "sub_question_id": "SQ2", "claim": "Survey respondents said Copilot helped them complete tasks faster, especially repetitive ones; this is a reported perception rather than a task-type comparison in the controlled experiment.", "quote": "In the survey, we saw that developers reported they complete tasks faster when using GitHub Copilot, especially repetitive ones.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.8, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e4", "source_id": "S4", "sub_question_id": "SQ4", "claim": "The Copilot group had a higher task completion rate, 78% versus 70%, but the source does not report comparative code-quality results.", "quote": "The group that used GitHub Copilot had a higher rate of completing the task (78%, compared to 70% in the group without Copilot).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e5", "source_id": "S4", "sub_question_id": "SQ5", "claim": "The experiment randomized 95 professional developers but evaluated them on a single JavaScript HTTP-server task, limiting the scope of the experimental evidence described here.", "quote": "We recruited 95 professional developers, split them randomly into two groups, and timed how long it took them to write an HTTP server in JavaScript.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S4-e6", "source_id": "S4", "sub_question_id": "SQ4", "claim": "The source says that potential effects on code quality were still being investigated, so it does not establish whether speed gains came with quality gains or losses.", "quote": "There\u2019s more to uncover! We\u2019re conducting more experiments and a more thorough analysis of the experiment data we already collected\u2014looking into heterogeneous effects, or potential effects on the quality of code\u2014and we are planning further academic publications to share our findings.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.85, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e1", "source_id": "S5", "sub_question_id": "SQ1", "claim": "In the two field experiments, Copilot access was associated with suggestive increases in pull requests completed per week, with estimates varying by company and specification.", "quote": "Our preliminary results provide suggestive evidence that these developers became more productive, completing 12.92% to 21.83% more pull requests per week at Microsoft and 7.51% to 8.69% at Accenture (depending on specification).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S5-e2", "source_id": "S5", "sub_question_id": "SQ1", "claim": "The field-experiment estimates were imprecise and reached statistical significance only under a particular weighting approach.", "quote": "Due to low compliance in the Microsoft experiment and internal organizational changes at Accenture, our estimates are not very precise and only reach statistical significance if we weight more heavily periods in which Copilot uptake differs across control and treatment.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 1.0, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S5-e3", "source_id": "S5", "sub_question_id": "SQ1", "claim": "A cited controlled study found no statistically significant difference in completion time, despite participants preferring Copilot.", "quote": "Vaithilingam et al. (2022) conducted a within-subject study in a randomized controlled experiment involving GitHub Copilot, in which each participant completed two tasks, one with Copilot access and one without. Contrary to other studies, this study found no statistically significant differences in completion time, although participants preferred using Copilot in their programming work.", "quote_match": "exact_normalized", "page": null, "stance": "contradicts", "confidence": 0.95, "citable": true, "query_id": "Q2", "cross_attributed": false}, {"id": "S5-e4", "source_id": "S5", "sub_question_id": "SQ2", "claim": "In a cited study of building an HTTP server, Copilot users completed the task substantially faster, but Copilot did not affect whether the task was completed.", "quote": "Peng et al. (2023) hired 95 professional programmers to develop an HTTP server in JavaScript. The group that used GitHub Copilot completed the task 55.8% faster, yet there was no effect on whether the task was completed.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.8, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e5", "source_id": "S5", "sub_question_id": "SQ3", "claim": "A cited study reported that Copilot benefited less-experienced developers, as well as high-workload and older developers.", "quote": "Additionally, Copilot benefited less experienced, high-workload, and older developers.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.95, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S5-e6", "source_id": "S5", "sub_question_id": "SQ3", "claim": "A cited experiment found performance gains among both experienced programmers and people without programming experience; with GPT-3, nonprogrammers reached performance levels comparable to experienced programmers.", "quote": "Campero et al. (2022) conducted experiments to assess the impact of GPT-3 on coding performance among both experienced programmers and those with no programming experience. Their findings show that GPT-3 increased performance for both groups. Programmers achieved a 27% increase in speed, whereas nonprogrammers reached performance levels comparable to experienced programmers with the assistance of GPT-3.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e1", "source_id": "S2", "sub_question_id": "SQ1", "claim": "Reported productivity effects vary widely across studies, from a slowdown to a large speedup, with estimates depending on study and work context.", "quote": "somewhere between a 20% slowdown and a 100% speedup, depending on which study you read, which developers you measure, which language they work in, and how clean their codebase happens to be.", "quote_match": "exact_normalized", "page": null, "stance": "neutral", "confidence": 0.99, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e2", "source_id": "S2", "sub_question_id": "SQ1", "claim": "In one two-phase maintainability study, initial development was roughly 30% to 55% faster with AI support.", "quote": "Initial development in phase one was roughly 30% to 55% faster with AI support.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.9, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S2-e3", "source_id": "S2", "sub_question_id": "SQ2", "claim": "On greenfield work, reported gains were larger for low-complexity tasks than for high-complexity tasks.", "quote": "On greenfield projects, low-complexity tasks produce the largest gains, typically in the 30% to 40% range. For high-complexity greenfield work, those gains fall to a more modest 10% to 15%.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S2-e4", "source_id": "S2", "sub_question_id": "SQ2", "claim": "On existing or legacy codebases, gains were smaller overall and especially limited for high-complexity tasks.", "quote": "On brownfield code \u2014 existing or legacy codebases \u2014 it becomes much harder to extract value from AI. Low-complexity tasks tend to yield gains of about 15% to 20%, while high-complexity tasks often produce only marginal improvements, in the range of 0% to 10% (Denisov-Blanch, 2025b).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 1.0, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S2-e5", "source_id": "S2", "sub_question_id": "SQ2", "claim": "Survey findings in the source report larger time savings for new-code, boilerplate, and documentation tasks than for planning, architecture, maintenance, and sensitive tasks.", "quote": "Recent survey data points in the same direction. Writing new code, generating boilerplate, and producing documentation show the largest time savings. Planning, architecture work, maintenance, and security- or compliance-sensitive tasks show the smallest improvements (State of Generative AI in Software Development, 2026).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.98, "citable": true, "query_id": "Q3", "cross_attributed": false}, {"id": "S2-e6", "source_id": "S2", "sub_question_id": "SQ3", "claim": "A METR study found that AI assistants slowed experienced open-source developers working on large, complex projects by as much as 20%.", "quote": "A METR study from early 2025 found that AI assistants actually slowed experienced open-source developers working on large, complex projects by as much as 20% (METR, 2025).", "quote_match": "exact_normalized", "page": null, "stance": "contradicts", "confidence": 0.98, "citable": true, "query_id": "Q5", "cross_attributed": false}, {"id": "S6-e1", "source_id": "S6", "sub_question_id": "SQ1", "claim": "The source reports an average productivity increase of 31.4% for developers using AI coding assistants compared with traditional approaches.", "quote": "Developers using AI coding assistants report an average productivity increase of 31.4% compared to traditional approaches.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S6-e2", "source_id": "S6", "sub_question_id": "SQ1", "claim": "The source says measured productivity gains vary, giving a reported range of 20\u201355%.", "quote": "Many developers FEEL they\u2019re coding faster with AI, but measurements show varying productivity gains (20-55%).", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.82, "citable": true, "query_id": "Q1", "cross_attributed": false}, {"id": "S6-e3", "source_id": "S6", "sub_question_id": "SQ3", "claim": "The source claims senior and experienced developers gain the most from AI coding.", "quote": "Interestingly, data shows that senior and experienced developers gain the most from AI Coding.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.87, "citable": true, "query_id": "", "cross_attributed": true}, {"id": "S6-e4", "source_id": "S6", "sub_question_id": "SQ4", "claim": "The source reports an increase in security vulnerabilities in AI-assisted code, indicating a potential quality cost alongside productivity gains.", "quote": "Not all news is positive\u2014studies show a 23.7% increase in security vulnerabilities in AI-assisted code.", "quote_match": "exact_normalized", "page": null, "stance": "supports", "confidence": 0.76, "citable": true, "query_id": "", "cross_attributed": true}], "sources": [{"id": "S1", "url": "https://arxiv.org/html/2302.06590v1", "title": "The Impact of AI on Developer Productivity: Evidence from GitHub Copilot", "domain": "arxiv.org", "source_type": "academic", "content_origin": "provider_raw", "quality_score": 0.971, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S2", "url": "https://ingoeichhorst.medium.com/state-of-ai-coding-efficiency-2026-1abfa0ab7434", "title": "Medium", "domain": "ingoeichhorst.medium.com", "source_type": "blog", "content_origin": "provider_raw", "quality_score": 0.562, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S3", "url": "https://www.alphaxiv.org/abs/2302.06590", "title": "The Impact of AI on Developer Productivity: Evidence from GitHub Copilot | alphaXiv", "domain": "alphaxiv.org", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.61, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S4", "url": "https://github.blog/news-insights/research/research-quantifying-github-copilots-impact-on-developer-productivity-and-happiness", "title": "Research: quantifying GitHub Copilot\u2019s impact on developer productivity and happiness - The GitHub Blog", "domain": "github.blog", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.61, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"id": "S5", "url": "https://mit-genai.pubpub.org/pub/v5iixksv", "title": "The Productivity Effects of Generative AI: Evidence from a Field Experiment with GitHub Copilot \u00b7 From Novel Chemicals to Opera", "domain": "mit-genai.pubpub.org", "source_type": "other", "content_origin": "provider_raw", "quality_score": 0.608, "page_count": null, "usable": true, "fetch_status": "provider_content"}, {"